{
  "name": "dsh-remote-app",
  "version": "0.6.5",
  "private": true,
  "description": "iOS-only client fork of ds-harness-remote (DSH Remote), end-to-end encrypted remote access to DeepSeek Harness workspaces.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anselorville/dsh-remote-app.git"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build:packages": "pnpm --filter './packages/*' -r build",
    "ios": "pnpm --filter @dsh-remote/mobile ios",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom@0.8": "^0.8.15",
      "@xmldom/xmldom@0.9": "^0.9.12",
      "brace-expansion@5": "^5.0.12",
      "compression@1": "^1.8.2",
      "js-yaml@4": "^4.3.2",
      "shell-quote@1": "^1.11.0",
      "source-map-js@1": "^1.2.2"
    }
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
